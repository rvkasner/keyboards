// Keyboard layouts for the United States of America
// Kasner layout based on Dvorak layout

default partial alphanumeric_keys modifier_keys
xkb_symbols "kasner" {

    include "us(basic)"
    name[Group1]= "English (Kasner)";

    // ============================================================
    // Row 1 - Functional 
    // ============================================================
    
    // Default configuration for Functional row

    // key <ESC>  { [ Escape, Escape ] };

    // key <FK01> { [ F1, F1 ] };
    // key <FK02> { [ F2, F2 ] };
    // key <FK03> { [ F3, F3 ] };
    // key <FK04> { [ F4, F4 ] };
    // key <FK05> { [ F5, F5 ] };
    // key <FK06> { [ F6, F6 ] };
    // key <FK07> { [ F7, F7 ] };
    // key <FK08> { [ F8, F8 ] };
    // key <FK09> { [ F9, F9 ] };
    // key <FK10> { [ F10, F10 ] };
    // key <FK11> { [ F11, F11 ] };
    // key <FK12> { [ F12, F12 ] };

    // key <PRSC> { [ Print, Print ] };
    // key <SCLK> { [ Scroll_Lock, Scroll_Lock ] };
    // key <PAUS> { [ Pause, Break ] };

    // ============================================================
    // Row 2 - Numbers
    // ============================================================
    
    key <TLDE> { [ apostrophe, quotedbl ] };                // ' "
    key <AE01> { [ exclam, 1 ] };                           // ! 1
    key <AE02> { [ question, 2 ] };                         // ? 2
    key <AE03> { [ equal, 3 ] };                            // = 3
    key <AE04> { [ minus, 4 ] };                            // - 4
    key <AE05> { [ semicolon, 5 ] };                        // ; 5
    key <AE06> { [ comma, 6 ] };                            // , 6
    key <AE07> { [ period, 7 ] };                           // . 7
    key <AE08> { [ colon, 8 ] };                            // : 8
    key <AE09> { [ parenleft, 9 ] };                        // ( 9
    key <AE10> { [ parenright, 0 ] };                       // ) 0
    key <AE11> { [ plus, percent ] };                       // + %
    key <AE12> { [ asterisk, bar ] };                       // * |

    // key <BKSP> { [ BackSpace, BackSpace ] };             // Default config for Backspace

    // ============================================================
    // Row 3 - Top level letters
    // ============================================================
    
    // key <TAB>  { [ Tab, ISO_Left_Tab ] };                   // Tab Left Tab

    key <AD01> { [ underscore, numbersign ] };              // _ #
    key <AD02> { [ braceleft, less ] };                     // { <
    key <AD03> { [ braceright, greater ] };                 // } >
    key <AD04> { [ p, P ] };                     
    key <AD05> { [ y, Y ] };                         
    key <AD06> { [ f, F ] };                     
    key <AD07> { [ g, G ] };                      
    key <AD08> { [ c, C ] };                                
    key <AD09> { [ r, R ] };
    key <AD10> { [ l, L ] };
    key <AD11> { [ bracketleft, dollar ] };                 // [ $
    key <AD12> { [ bracketright, at ] };                    // ] @
    key <BKSL> { [ slash, backslash ] };                    // / \ 

    // ============================================================
    // Row 4 - Middle level letters
    // ============================================================
    
    // key <CAPS> { [ BackSpace, CapsLock ] };                // Backspace instead of Caps Lock

    key <AC01> { [ a, A ] };
    key <AC02> { [ o, O ] };
    key <AC03> { [ e, E ] };
    key <AC04> { [ u, U ] };
    key <AC05> { [ i, I ] };
    key <AC06> { [ d, D ] };
    key <AC07> { [ h, H ] };
    key <AC08> { [ t, T ] };
    key <AC09> { [ n, N ] };
    key <AC10> { [ s, S ] };
    key <AC11> { [ ampersand, asciicircum ] };              // & ^

    // key <RTRN> { [ Enter, Enter ] };                     // Default config for Enter

    // ============================================================
    // Row 5 - Low level letters
    // ============================================================
    
    // key <LSGT> { [] };                                   // Default config
    
    key <AB01> { [ grave, asciitilde ] };                   // ` ~
    key <AB02> { [ q, Q ] };
    key <AB03> { [ j, J ] }; 
    key <AB04> { [ k, K ] };
    key <AB05> { [ x, X ] };
    key <AB06> { [ b, B ] };
    key <AB07> { [ m, M ] };
    key <AB08> { [ w, W ] };
    key <AB09> { [ v, V ] };
    key <AB10> { [ z, Z ] };

    // ============================================================
    // NUMPAD & Navigation
    // ============================================================
    
    // Default config for Numpad

    // // Row 2 Numpad
    // key <NMLK> { [ Num_Lock, Num_Lock ] };                  // Num Lock
    // key <KPDV> { [ KP_Divide, KP_Divide ] };                // /
    // key <KPMU> { [ KP_Multiply, KP_Multiply ] };            // *
    // key <KPSU> { [ KP_Subtract, KP_Subtract ] };            // -

    // // Row 3 Numpad 
    // key <KP7>  { [ KP_7, KP_Home ] };
    // key <KP8>  { [ KP_8, KP_Up ] };
    // key <KP9>  { [ KP_9, KP_Page_Up ] };
    // key <KPAD> { [ KP_Add, KP_Add ] };

    // // Row 4 Numpad 
    // key <KP4>  { [ KP_4, KP_Left ] };
    // key <KP5>  { [ KP_5, NoSymbol ] }; 
    // key <KP6>  { [ KP_6, KP_Right ] };

    // // Row 5 Numpad 
    // key <KP1>  { [ KP_1, KP_End ] };
    // key <KP2>  { [ KP_2, KP_Down ] };  
    // key <KP3>  { [ KP_3, KP_Page_Down ] };
    // key <KPEN> { [ KP_Enter, KP_Enter ] };

    // // Row 6 Numpad 
    // key <KP0>  { [ KP_0, KP_Insert ] };
    // key <KPDL> { [ KP_Decimal, KP_Delete ] };
};

// English variant (explicit), so desktops can reference kasner(en)
// and render the layout preview correctly.
partial alphanumeric_keys modifier_keys
xkb_symbols "en" {

    include "kasner(kasner)"
    name[Group1]= "Kasner En";
};

// ------------------------------------------------------------
// Kasner Cyrillic variants
//
// Goal: keep Kasner symbols/punctuation identical to the English
// layout above, but place Cyrillic letters according to the macOS
// Kasner Ru / Kasner Uk layouts from this repo.
// ------------------------------------------------------------

partial alphanumeric_keys modifier_keys
xkb_symbols "ru" {

    include "kasner(kasner)"
    name[Group1]= "Kasner Ru";

    // Row 3 - Top level letters
    key <AD04> { [ Cyrillic_ka, Cyrillic_KA ] };
    key <AD05> { [ Cyrillic_ie, Cyrillic_IE ] };
    key <AD06> { [ Cyrillic_en, Cyrillic_EN ] };
    key <AD07> { [ Cyrillic_ghe, Cyrillic_GHE ] };
    key <AD08> { [ Cyrillic_sha, Cyrillic_SHA ] };
    key <AD09> { [ Cyrillic_shcha, Cyrillic_SHCHA ] };
    key <AD10> { [ Cyrillic_ze, Cyrillic_ZE ] };
    key <AD11> { [ Cyrillic_ha, Cyrillic_HA ] };
    key <AD12> { [ Cyrillic_hardsign, Cyrillic_HARDSIGN ] };

    // Row 4 - Middle level letters
    key <AC01> { [ Cyrillic_ef, Cyrillic_EF ] };
    key <AC02> { [ Cyrillic_yeru, Cyrillic_YERU ] };
    key <AC03> { [ Cyrillic_ve, Cyrillic_VE ] };
    key <AC04> { [ Cyrillic_a, Cyrillic_A ] };
    key <AC05> { [ Cyrillic_pe, Cyrillic_PE ] };
    key <AC06> { [ Cyrillic_er, Cyrillic_ER ] };
    key <AC07> { [ Cyrillic_o, Cyrillic_O ] };
    key <AC08> { [ Cyrillic_el, Cyrillic_EL ] };
    key <AC09> { [ Cyrillic_de, Cyrillic_DE ] };
    key <AC10> { [ Cyrillic_zhe, Cyrillic_ZHE ] };
    key <AC11> { [ Cyrillic_e, Cyrillic_E ] }; // Э

    // Row 5 - Low level letters
    key <AB02> { [ Cyrillic_ya, Cyrillic_YA ] };
    key <AB03> { [ Cyrillic_che, Cyrillic_CHE ] };
    key <AB04> { [ Cyrillic_es, Cyrillic_ES ] };
    key <AB05> { [ Cyrillic_em, Cyrillic_EM ] };
    key <AB06> { [ Cyrillic_i, Cyrillic_I ] };
    key <AB07> { [ Cyrillic_te, Cyrillic_TE ] };
    key <AB08> { [ Cyrillic_softsign, Cyrillic_SOFTSIGN ] };
    key <AB09> { [ Cyrillic_be, Cyrillic_BE ] };
    key <AB10> { [ Cyrillic_yu, Cyrillic_YU ] };
};

